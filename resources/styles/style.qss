/* 灵动岛主容器 - 完美胶囊形态 */
#IslandContainer {
    background-color: #000000;
    border-radius: 9999px;
    border: none;
}

/* 折叠态时间标签 - 常驻时透明，仅留黑胶囊 */
#TimeLabel {
    color: transparent;
    font-size: 12px;
    font-weight: 500;
}

/* 展开态日期时间标签 */
#DateLabel {
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 500;
}

/* 功能数值标签 */
#ValueLabel {
    color: #FFFFFF;
    font-size: 12px;
    font-weight: 400;
}

/* 状态标签（WiFi/蓝牙/电池） */
#StatusLabel {
    color: #E0E0E0;
    font-size: 10px;
    font-weight: 400;
}

/* 图标标签 */
#IconLabel {
    color: #FFFFFF;
    font-size: 14px;
}

/* 亮度/音量滑动条 */
QSlider#CapsuleSlider::horizontal {
    height: 4px;
    background-color: #333333;
    border-radius: 2px;
}
QSlider#CapsuleSlider::horizontal::handle {
    background-color: #FFFFFF;
    width: 12px;
    height: 12px;
    border-radius: 6px;
    margin: -4px 0;
}
QSlider#CapsuleSlider::horizontal::groove {
    border: none;
}

/* URL通知标题 */
#DialogTitle {
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 600;
    text-align: center;
}

/* URL链接文本 */
#UrlLabel {
    color: #E0E0E0;
    font-size: 12px;
}

/* 通知按钮 */
QPushButton#DialogButton {
    background-color: #333333;
    color: #FFFFFF;
    border: none;
    border-radius: 20px;
    padding: 4px 12px;
    font-size: 12px;
}
QPushButton#DialogButton:hover {
    background-color: #444444;
}

/* URL滚动区域 */
#UrlScrollArea {
    background-color: #111111;
    border: none;
    border-radius: 8px;
}
